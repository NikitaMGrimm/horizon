    {"case": "more isolates than English", "english": "\u2067x\u2069", "text": "\u2067y\u2069\u2067z\u2069", "rule": "bidi"},
    {"case": "embedding closed as an isolate", "english": "\u202bx\u202c\u2067y\u2069", "text": "\u202by\u2069\u2067z\u202c", "rule": "bidi"},
    {"case": "formatting code English lacks", "english": "Hello", "text": "\u00a7cHallo", "rule": "formatting_code"},
