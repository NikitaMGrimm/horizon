{
  "about": "The rules a translated string is held to beyond its placeholders (docs/translations.md): `rule` is the first one `text`, a translation of `english`, breaks, in the order control, invisible, bidi, formatting_code, line_break, length, unbroken_run, or null. tools/lang_coverage.py's text_problem and lang.rs's bundled-file test both read this file, so the importer and the test cannot drift.",
  "cases": [
    {"case": "plain", "english": "Hello", "text": "Hallo", "rule": null},
    {"case": "line break kept", "english": "a\nb", "text": "c\nd\ne", "rule": null},
    {"case": "line breaks past twice English's", "english": "a\nb", "text": "a\nb\nc\nd", "rule": "line_break"},
    {"case": "no line break English lacks", "english": "ab", "text": "a\nb", "rule": "line_break"},
    {"case": "tab only where English has one", "english": "a b", "text": "a\tb", "rule": "control"},
    {"case": "escape is never allowed", "english": "a\u001bb", "text": "a\u001bb", "rule": "control"},
    {"case": "C1 control", "english": "ab", "text": "a\u0085b", "rule": "control"},
    {"case": "zero-width space", "english": "ab", "text": "a\u200bb", "rule": "invisible"},
    {"case": "zero-width space English has", "english": "a\u200bb", "text": "c\u200bd", "rule": null},
    {"case": "line separator", "english": "ab", "text": "a\u2028b", "rule": "invisible"},
    {"case": "byte order mark", "english": "ab", "text": "\ufeffab", "rule": "invisible"},
    {"case": "tag character", "english": "ab", "text": "a\udb40\udc41b", "rule": "invisible"},
    {"case": "noncharacter", "english": "ab", "text": "a\ufdd0b", "rule": "invisible"},
    {"case": "plane noncharacter", "english": "ab", "text": "a\ud83f\udffeb", "rule": "invisible"},
    {"case": "private use", "english": "ab", "text": "a\ue000b", "rule": "invisible"},
    {"case": "supplementary private use", "english": "ab", "text": "a\udb80\udc00b", "rule": "invisible"},
    {"case": "joiners and marks stay", "english": "ab", "text": "a\u200c\u200d\u200e\u200f\u061cb", "rule": null},
    {"case": "variation selector after a base", "english": "ok", "text": "\u2764\ufe0f ok", "rule": null},
    {"case": "variation selector at the start", "english": "ok", "text": "\ufe0fok", "rule": "invisible"},
    {"case": "variation selector after a space", "english": "ok", "text": "o \ufe0fk", "rule": "invisible"},
    {"case": "two variation selectors", "english": "ok", "text": "\u2764\ufe0f\ufe0e", "rule": "invisible"},
    {"case": "bidi control English lacks", "english": "ab", "text": "a\u2067b\u2069", "rule": "control"},
